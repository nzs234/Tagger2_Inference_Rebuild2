# Runtime and local data
.venv/
.venv-dev/
venv/
data/
logs/
dist/
.release_*/
.release_smoke_*/
*.zip
*.db
*.db-shm
*.db-wal
config/*.local.*
secrets/

# The embedded CPython runtime is provisioned by setup.bat, not tracked
runtime/

# Isolated PaddleOCR runtime and user-provisioned model cache are not tracked.
runtime_ocr/

# Model/cache binaries are provisioned separately
models/*
!models/.gitkeep
data_cache/*
!data_cache/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.tmp-mig/
.tmp-pytest/
# Download cache for scripts/build_tag_translations.py; the generated
# dictionaries under resources/tag_translations/ are committed.
.tmp-tag-translations/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
playwright-report/
test-results/

# Editors/OS
.vscode/
.idea/
Thumbs.db
Desktop.ini

